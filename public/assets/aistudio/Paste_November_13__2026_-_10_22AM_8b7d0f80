            b.classList.remove('bg-surface-container-lowest', 'text-primary', 'shadow-xs', 'font-semibold');
            b.classList.add('text-on-surface-variant', 'font-medium');
          });
          btn.classList.add('bg-surface-container-lowest', 'text-primary', 'shadow-xs', 'font-semibold');
          btn.classList.remove('text-on-surface-variant', 'font-medium');
        });
      });

      // Search and category combination filter
      function applyFilters() {
        const query = searchInput ? searchInput.value.toLowerCase().trim() : '';

        tableRows.forEach(row => {
          const type = row.dataset.type || '';
          const text = row.innerText.toLowerCase();

          const matchesCategory = currentCategory === 'all' || type.includes(currentCategory);
          const matchesQuery = query === '' || text.includes(query);

          if (matchesCategory && matchesQuery) {
            row.style.display = '';
          } else {
            row.style.display = 'none';
          }
        });
      }

      if (searchInput) {
        searchInput.addEventListener('input', applyFilters);
      }

      // Modal handling
      if (verifyBtn && verifyModal) {
        verifyBtn.addEventListener('click', () => {
          verifyModal.classList.remove('hidden');
        });
      }

      const hideModal = () => {
        if (verifyModal) verifyModal.classList.add('hidden');
      };

      if (closeModalBtn) closeModalBtn.addEventListener('click', hideModal);
      if (modalDoneBtn) modalDoneBtn.addEventListener('click', hideModal);

      // JSON proof clipboard copying
      if (copyProofBtn) {
        copyProofBtn.addEventListener('click', () => {
          const sampleProof = JSON.stringify({
            event_id: "AUD-9941",
            timestamp: "2025-05-18T14:23:41.145Z",
            policy_version: "2025.4.1",
            agent: "agt_procure_09",
            verdict: "VETO_ENFORCED",
            reasons: ["SINGLE_TX_EXCEEDED_20XRP", "ROLLING_DAILY_LIMIT_EXCEEDED"],
            vault_status: "AIR_GAPPED_SAFE",
            proof_hash: "0x882af9c3b889a24bb1829e19001bfa8291ce"
          }, null, 2);

          navigator.clipboard.writeText(sampleProof).then(() => {
            const originalHtml = copyProofBtn.innerHTML;
            copyProofBtn.innerHTML = '<span class="material-symbols-outlined text-[16px] text-tertiary">check</span><span>Copied!</span>';
            setTimeout(() => {
              copyProofBtn.innerHTML = originalHtml;
            }, 2000);
          }).catch(() => {});
        });
      }

      // Stream pause toggle micro-interaction
      let isStreaming = true;
      if (streamToggleBtn && streamStatusText) {
        streamToggleBtn.addEventListener('click', () => {
          isStreaming = !isStreaming;
          if (isStreaming) {
            streamStatusText.textContent = 'Live Ingestion Active';
            streamToggleBtn.querySelector('span:first-child').className = 'w-2 h-2 rounded-full bg-tertiary-container animate-pulse';
          } else {
            streamStatusText.textContent = 'Ingestion Paused';
            streamToggleBtn.querySelector('span:first-child').className = 'w-2 h-2 rounded-full bg-secondary';
          }
        });
      }

      // Export feedback
      if (exportBtn) {
        exportBtn.addEventListener('click', () => {
          const orig = exportBtn.innerHTML;
          exportBtn.innerHTML = '<span class="material-symbols-outlined text-[18px] animate-spin">refresh</span><span>Generating CSV Archive...</span>';
          setTimeout(() => {
            exportBtn.innerHTML = '<span class="material-symbols-outlined text-[18px]">done</span><span>Archive Downloaded</span>';
            setTimeout(() => {
              exportBtn.innerHTML = orig;
            }, 2000);
          }, 900);
        });
      }
    })();
  </script>
