  const cancelModalBtn = document.getElementById('cancelAddVendorBtn');
  const saveVendorBtn = document.getElementById('saveVendorBtn');
  const modalBackdrop = document.getElementById('vendorModalBackdrop');
  const modalDialog = document.getElementById('vendorModalDialog');
  const searchInput = document.getElementById('vendorSearchInput');
  const exportBtn = document.getElementById('exportBtn');
  const actionToast = document.getElementById('actionToast');
  const toastMessage = document.getElementById('toastMessage');

  // Modal Open/Close Transitions
  function showModal() {
    modalBackdrop.classList.remove('hidden');
    setTimeout(() => {
      modalBackdrop.classList.remove('opacity-0');
      modalDialog.classList.remove('scale-95');
      modalDialog.classList.add('scale-100');
    }, 10);
  }

  function hideModal() {
    modalBackdrop.classList.add('opacity-0');
    modalDialog.classList.remove('scale-100');
    modalDialog.classList.add('scale-95');
    setTimeout(() => {
      modalBackdrop.classList.add('hidden');
    }, 200);
  }

  openModalBtn.addEventListener('click', showModal);
  closeModalBtn.addEventListener('click', hideModal);
  cancelModalBtn.addEventListener('click', hideModal);

  modalBackdrop.addEventListener('click', (e) => {
    if (e.target === modalBackdrop) {
      hideModal();
    }
  });

  // Toast Functionality
  function displayToast(msg, isSuccess = true) {
    toastMessage.textContent = msg;
    actionToast.classList.remove('translate-y-24', 'opacity-0', 'pointer-events-none');
    setTimeout(() => {
      actionToast.classList.add('translate-y-24', 'opacity-0', 'pointer-events-none');
    }, 3200);
  }

  // Save Vendor Simulation
  saveVendorBtn.addEventListener('click', () => {
    const name = document.getElementById('vendorName').value;
    if (!name) {
      displayToast('Please enter a vendor business name.');
      return;
    }
    hideModal();
    displayToast(`Vendor "${name}" queued for Administrator dual-sign approval.`);
  });

  // Copy to Clipboard
  document.querySelectorAll('.copy-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      const wallet = btn.getAttribute('data-wallet');
      if (navigator.clipboard && wallet) {
        navigator.clipboard.writeText(wallet).then(() => {
          displayToast(`Wallet address copied: ${wallet.substring(0, 14)}...`);
        });
      } else {
        displayToast('Wallet address copied to clipboard');
      }
    });
  });

  // Search Filter Simulation
  searchInput.addEventListener('input', (e) => {
    const query = e.target.value.toLowerCase();
    const rows = document.querySelectorAll('#vendorsTable tbody tr');
    rows.forEach(row => {
      const text = row.innerText.toLowerCase();
      row.style.display = text.includes(query) ? '' : 'none';
    });
  });

  // Export Directory
  exportBtn.addEventListener('click', () => {
    displayToast('Exporting approved vendor directory (JSON / CSV)...');
  });
</script></main></div></body></html>

