PORT=4000
AEGIS_DB_PATH=./data/aegis.db
# Set a long random value yourself in backend/.env. Never commit it.
CFO_TOKEN=
# Set your own value for the agent (MCP) token, never commit it.
AGENT_TOKEN=
# Must be set to "simulation" for the worker to start. Real execution is not implemented.
AEGIS_EXECUTION_MODE=
